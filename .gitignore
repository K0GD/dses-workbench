# SigMF binary IQ recordings — large, regenerable from the radio
*.sigmf-data

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
/.conda/

# Packaging artifacts (PyInstaller, py2app, Briefcase, cx_Freeze)
build/
dist/
*.app/
*.dmg
*.msi
*.exe
*.pkg

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Editors / IDEs
# Track a curated subset of .vscode for cross-machine consistency;
# ignore everything else (workspace state, transient files).
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.claude/

# Logs
*.log

# Microsoft Word lock files (created while a .docx is open in Word)
~$*

# DOCX intermediates (throwaway; build_doc.py makes the .pdf deliverables)
*.docx
