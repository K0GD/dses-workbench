{
  "files.associations": {
    "*.grc": "yaml",
    "*.sigmf-meta": "json"
  },
  "search.exclude": {
    "**/*.sigmf-data": true,
    "**/build": true,
    "**/dist": true
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  // Type-checking is off: this is a hand-maintained GNU Radio / PySide6 /
  // pyqtgraph / numpy app, and those libraries' type stubs produce dozens of
  // false positives (unscoped Qt enums like Qt.Horizontal, signal.connect
  // slot signatures, pyqtgraph kwargs, numpy ArrayLike). Import resolution
  // and autocomplete still work via the interpreter below. Switch to "basic"
  // if you want type hints back and can tolerate the stub noise.
  "python.analysis.typeCheckingMode": "off",
  "python.terminal.activateEnvironment": true,
  // Radioconda has GNU Radio, PySide6, pyqtgraph, SoapySDR, etc., so pointing
  // Pylance here resolves the "import could not be resolved" warnings. This
  // path is WINDOWS-SPECIFIC; on macOS/Linux pick the Radioconda interpreter
  // via "Python: Select Interpreter" (commonly ~/radioconda/bin/python) — a
  // per-machine choice that overrides this default.
  "python.defaultInterpreterPath": "C:\\ProgramData\\radioconda\\python.exe",
  "[python]": {
    "editor.formatOnSave": false,
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "python-envs.defaultEnvManager": "ms-python.python:conda",
  "python-envs.defaultPackageManager": "ms-python.python:conda"
}
